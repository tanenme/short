# ============================================================
# Enterprise YouTube Shorts Studio — Environment Configuration
# Salin file ini menjadi `.env` di root workspace E:\YT\short\.env
# JANGAN PERNAH commit file `.env` ke Git!
# ============================================================

# Workspace root (kosongkan untuk auto-detect dari lokasi file ini)
STUDIO_ROOT=E:/YT/short

# --- External Search & Sourcing ---
EXA_API_KEY=

# --- AI Vision / Audio / LLM Endpoint (OpenAI-compatible) ---
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_VISION_MODEL=ag/gemini-3.8-flash-high
AI_AUDIO_MODEL=ag/gemini-3.8-flash-high
AI_TEXT_MODEL=ag/gemini-3.8-flash-high

# --- ElevenLabs Voiceover (opsional untuk auto-TTS Fase 4) ---
ELEVENLABS_API_KEY=

# --- Local Tool Overrides (kosongkan untuk auto-discover) ---
FFMPEG_BIN=
FFPROBE_BIN=
YTDLP_BIN=
CAPCUT_DRAFTS_DIR=

# --- Fallback Legacy Env (opsional, untuk migrasi mulus dari Hermes) ---
LEGACY_HERMES_ENV=C:/Users/ronyt/AppData/Local/hermes/.env
